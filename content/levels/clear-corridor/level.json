  "risk": {
    "mode": "elapsed",
    "seconds": 50,
    "initial": 0,
    "warningAt": 65,
    "peakFeedback": "训练时间到了，还没有完成收纳和检查。再试一次，不用着急。",
    "timeout": "fail"
  },
  "completion": {
    "requires": [
      "box-stored",
      "chair-stored",
      "case-stored",
      "scooter-stored",
      "route-checked"
    ],
    "settleMs": 1800,
    "title": "通道，畅通了",
    "status": "完成",
    "summary": "收回自家，不换角落；通道、出口和消防设施前都不堆物。平时及时整理，有火烟时不为收拾物品耽误避险。",
    "fixedStars": 3
  },
  "stages": [
