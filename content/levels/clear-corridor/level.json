    },
    {
      "id": "chair-to-fire-access",
      "source": "chair",
      "mode": "drop",
      "target": "fire-access",
      "grants": [],
      "outcome": "neutral",
      "animation": "return-chair",
      "feedback": "这里要留给消防设施使用，不能把杂物挪到这里。"
    },
    {
      "id": "store-case",
      "source": "case",
