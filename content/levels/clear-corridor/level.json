{
  "schemaVersion": 1,
  "id": "clear-corridor",
  "title": "畅通的生命通道",
  "kind": "prevention",
  "order": 10,
  "location": "楼道 · 日常巡查",
  "description": "选择自家轻便杂物和正确去处，收好后检查通道、出口前和消防设施前是否畅通。",
  "safety": "仅在无火烟时整理自家轻便杂物。公共楼道不是储物空间；他人物品联系物主或物业，不擅自丢弃。不移动消防设施。火灾时不要因收拾物品耽误避险。人物试走只是演示，不是现实通道宽度验收。",
  "briefing": "平日整理：先点物品，再选去处；也可以直接拖动。",
  "objects": [
    {
      "id": "box",
      "label": "纸箱",
      "input": "drag",
      "disabledWhen": [
        "box-stored"
      ]
    },
    {
      "id": "chair",
      "label": "折叠椅",
      "input": "drag",
      "disabledWhen": [
        "chair-stored"
      ]
    },
    {
      "id": "case",
      "label": "空行李箱",
      "input": "drag",
      "disabledWhen": [
        "case-stored"
      ]
    },
    {
      "id": "scooter",
      "label": "玩具滑板车",
      "input": "drag",
      "disabledWhen": [
        "scooter-stored"
      ]
    },
    {
      "id": "inspector",
      "label": "检查通道",
      "input": "tap",
      "hudAction": true,
      "requires": [
        "box-stored",
        "chair-stored",
        "case-stored",
        "scooter-stored"
      ],
      "disabledWhen": [
        "route-checked"
      ]
    }
  ],
  "goals": [
    {
      "id": "box-stored",
      "label": "纸箱",
      "object": "box"
    },
    {
      "id": "chair-stored",
      "label": "折叠椅",
      "object": "chair"
    },
    {
      "id": "case-stored",
      "label": "空行李箱",
      "object": "case"
    },
    {
      "id": "scooter-stored",
      "label": "玩具滑板车",
      "object": "scooter"
    },
    {
      "id": "route-checked",
      "label": "检查通道",
      "object": "inspector",
      "showTarget": false
    }
  ],
  "interactions": [
    {
      "id": "store-box",
      "source": "box",
      "mode": "drop",
      "target": "storage",
      "grants": [
        "box-stored"
      ],
      "outcome": "correct",
      "animation": "store-box",
      "feedback": "纸箱收进自家：公共楼道不是储物空间。"
    },
    {
      "id": "box-to-corner",
      "source": "box",
      "mode": "drop",
      "target": "corner",
      "grants": [],
      "outcome": "neutral",
      "animation": "return-box",
      "feedback": "这里还是公共楼道，换个角落也不行。请收回自家。"
    },
    {
      "id": "box-to-fire-access",
      "source": "box",
      "mode": "drop",
      "target": "fire-access",
      "grants": [],
      "outcome": "neutral",
      "animation": "return-box",
      "feedback": "这里要留给消防设施使用，不能把杂物挪到这里。"
    },
    {
      "id": "store-chair",
      "source": "chair",
      "mode": "drop",
      "target": "storage",
