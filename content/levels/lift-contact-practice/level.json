      "label": "建立紧急联系",
      "object": "alarm-intercom",
      "showTarget": false
    },
    {
      "id": "location-reported",
      "label": "报告位置与电梯编号",
      "object": "location-info",
      "showTarget": false
    },
    {
      "id": "people-reported",
      "label": "报告人数与身体情况",
