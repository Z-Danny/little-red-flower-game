      ]
    },
    {
      "id": "gas",
      "label": "开关",
      "input": "tap",
      "disabledWhen": [
        "gas-off"
      ]
    },
    {
      "id": "person",
      "label": "人物",
      "input": "drag",
      "disabledWhen": [
        "evacuated"
      ]
    },
    {
      "id": "water",
      "label": "水杯",
      "input": "drag",
      "disabledWhen": []
    },
    {
      "id": "plate",
      "label": "餐盘",
      "input": "drag",
      "disabledWhen": []
    }
  ],
  "goals": [
    {
      "id": "covered",
      "label": "盖好锅口",
      "object": "lid"
    },
    {
      "id": "gas-off",
      "label": "关闭火源",
      "object": "gas"
    },
    {
      "id": "evacuated",
      "label": "安全撤离",
      "object": "person"
    }
  ],
  "interactions": [
    {
      "id": "cover",
      "source": "lid",
      "mode": "drop",
      "target": "pan",
