        "covered"
      ],
      "outcome": "correct",
      "animation": "cover"
    },
    {
      "id": "shutoff",
      "source": "gas",
      "mode": "tap",
      "grants": [
        "gas-off"
      ],
      "outcome": "correct",
      "animation": "shutoff"
    },
    {
      "id": "leave",
      "source": "person",
      "mode": "drop",
