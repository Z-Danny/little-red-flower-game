        "covered",
        "gas-off"
      ]
    },
    {
      "id": "water-error",
      "source": "water",
      "mode": "drop",
      "target": "pan",
      "grants": [],
      "outcome": "danger",
      "animation": "spill",
      "unless": [
        "covered"
      ],
      "riskDelta": 15,
      "feedback": "油锅起火不能泼水"
    }
