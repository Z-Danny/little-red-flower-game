metadata/rules = {
  "feedbackVersion": 2,
  "seconds": 50,
  "markMs": 800,
  "revealMs": 5500,
  "summary": "保持出口和消防器材周围通畅。发现破损电线，要退开并告诉老师。",
  "timeout": "fail",
  "id": "campus-classroom-check-v1",
  "title": "教室放学巡查",
  "order": 33,
  "targets": [
    {
      "id": "target-1",
      "name": "堵住出口的纸箱",
      "lesson": "纸箱挡住了通往门外的路。请老师安排清理，保持出口通畅。"
    },
    {
      "id": "target-2",
      "name": "露出线芯的电线",
      "lesson": "电线护套破损，线芯已经露出。退开并告诉老师，由校方停用设备并安排检修。"
    },
    {
      "id": "target-3",
      "name": "挡住灭火器的体育垫",
      "lesson": "体育垫挡住了灭火器，紧急时会妨碍取用。请老师安排挪开。"
    }
  ]
}
