metadata/rules = {
  "id": "typhoon-home",
  "title": "台风前的家",
  "order": 1,
  "seconds": 50,
  "timeout": "fail",
  "markMs": 800,
  "revealMs": 5500,
  "targets": [
    {
      "id": "plant",
      "name": "阳台花盆",
      "lesson": "阳台边缘的花盆可能坠落，应提前收回室内。"
    },
    {
      "id": "window",
      "name": "敞开的窗门",
      "lesson": "台风来临前关好门窗，避免风雨进入。"
    },
    {
      "id": "rail",
      "name": "伸出的晾衣杆",
      "lesson": "把阳台晾晒物和伸出的晾衣杆提前收好。"
    },
    {
      "id": "powerstrip",
      "name": "闲置插线板",
      "lesson": "在手和环境干燥、安全的情况下，断开不必要的电源。"
    },
    {
      "id": "cabinet",
      "name": "敞开的柜门",
      "lesson": "关好柜门，并提前固定容易倾倒的高柜。"
    }
  ],
  "summary": "台风来临前，及时收回阳台物品，关好门窗，安全断开不必要的电源，并固定容易倾倒的家具。红圈只是识别标记，不代表现实隐患已被处理。"
}
