metadata/rules = {
  "feedbackVersion": 2,
  "seconds": 50,
  "markMs": 800,
  "revealMs": 5500,
  "summary": "实验前检查标签和器具。异常物品交给老师处理。饮料放在实验室外。",
  "timeout": "fail",
  "id": "campus-lab-check-v1",
  "title": "实验室课前巡查",
  "order": 34,
  "targets": [
    {
      "id": "target-1",
      "name": "无标签的分装试剂瓶",
      "lesson": "分装试剂要贴清楚的标签。发现瓶子没有标签，先停下，请老师核实。"
    },
    {
      "id": "target-2",
      "name": "破裂的烧杯",
      "lesson": "杯口有缺口，杯身有裂纹。请老师收走并换用完好的器具。"
    },
    {
      "id": "target-3",
      "name": "实验台上的饮料",
      "lesson": "实验台可能沾有试剂。饮料留在实验室外，离开实验室前洗手。"
    }
  ]
}
