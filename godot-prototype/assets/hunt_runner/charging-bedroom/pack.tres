metadata/rules = {
  "id": "charging-bedroom",
  "title": "充电中的卧室",
  "order": 13,
  "seconds": 50,
  "markMs": 800,
  "revealMs": 5500,
  "targets": [
    {
      "id": "covered_phone",
      "name": "被枕头盖住的充电手机",
      "lesson": "充电手机不能埋在枕头下。"
    },
    {
      "id": "damaged_lead",
      "name": "破损充电组件",
      "lesson": "破损充电线应停用。"
    },
    {
      "id": "swollen_bank",
      "name": "鼓胀充电宝",
      "lesson": "鼓胀的充电宝不能继续用。"
    }
  ],
  "summary": "充电设备不要被枕头、被褥覆盖；破损充电线应停用。异常电池已停用，交专业人员处理，不拆壳、不挤压。儿童只识别并告知成人；出现烟火等危险，先远离求助。",
  "timeout": "fail"
}
