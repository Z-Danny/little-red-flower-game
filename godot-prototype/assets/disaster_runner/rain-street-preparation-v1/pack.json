    "missPenalty": 5,
    "goals": [
      {
        "id": "pool",
        "label": "低洼积水路段",
        "lesson": "绕开低洼积水，选择高处安全路线。"
      },
      {
        "id": "manhole",
        "label": "异常井盖",
        "lesson": "积水可能掩盖井口，发现异常立即绕行并报告。"
      },
      {
        "id": "cable",
        "label": "低垂断线",
        "lesson": "远离落地或低垂电线，不碰触、不靠近积水电力设施。"
      },
      {
        "id": "sign",
        "label": "松动广告牌",
        "lesson": "避开松动广告牌及其下方区域，不自行攀爬处理。"
      },
      {
        "id": "car",
        "label": "树下停放的车",
        "lesson": "应在暴雨前安全移车；车辆已被淹时，不得冒险返回取车。"
      },
      {
        "id": "garage",
        "label": "地下车库入口",
        "lesson": "管理方应提前封控低洼地下入口，不进入积水车库。"
      },
      {
        "id": "person",
        "label": "准备涉水的行人",
        "lesson": "不要贸然涉水，返回近旁坚固建筑避险。"
      }
    ],
