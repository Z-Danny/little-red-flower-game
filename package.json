{
  "name": "little-red-flower-game",
  "version": "0.1.0",
  "private": true,
  "description": "可离线运行的公益应急科普 HTML 游戏",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "node scripts/levels.mjs sync && vinext dev",
    "build": "node scripts/levels.mjs sync && vinext build",
    "test": "node scripts/test-kitchen.mjs && node scripts/test-typhoon.mjs && node scripts/test-pipeline.mjs && node scripts/test-leaderboard.mjs && node scripts/test-transcripts.mjs && node scripts/test-scene-hunt.mjs",
    "test:scene-hunt": "node scripts/test-scene-hunt.mjs",
    "test:transcripts": "node scripts/test-transcripts.mjs",
    "test:leaderboard": "node scripts/test-leaderboard.mjs",
    "test:pipeline": "node scripts/test-pipeline.mjs",
    "levels:check": "node scripts/levels.mjs validate",
    "levels:sync": "node scripts/levels.mjs sync",
    "levels:create": "node scripts/levels.mjs create",
    "levels:batch": "node scripts/levels.mjs batch",
    "levels:skin": "node scripts/levels.mjs skin",
    "levels:select-skin": "node scripts/levels.mjs select-skin",
    "levels:enable": "node scripts/levels.mjs enable",
    "levels:disable": "node scripts/levels.mjs disable",
    "test:art": "node scripts/check-kitchen-art.mjs",
    "test:paperbook": "node scripts/check-paperbook-art.mjs",
    "typecheck": "tsc --noEmit",
    "verify": "pnpm test && pnpm test:art && pnpm typecheck && pnpm build",
    "export:offline": "node scripts/export-offline.mjs",
    "build:site": "pnpm export:offline && node scripts/prepare-pages.mjs",
    "start": "wrangler dev --config dist/server/wrangler.json",
    "lint": "oxlint",
    "format": "oxfmt"
  },
  "dependencies": {
    "@base-ui/react": "1.7.0",
    "@shadcn/react": "0.3.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "date-fns": "4.1.0",
    "embla-carousel-react": "8.5.2",
    "input-otp": "1.4.2",
    "lucide-react": "1.31.0",
    "phaser": "3.90.0",
    "react": "19.2.6",
    "react-day-picker": "9.8.1",
    "react-dom": "19.2.6",
    "react-resizable-panels": "4.5.8",
    "react-server-dom-webpack": "19.2.6",
    "recharts": "3.8.0",
    "shadcn": "4.18.0",
    "tailwind-merge": "3.6.0",
    "tw-animate-css": "1.4.0",
    "vinext": "1.0.0-beta.5"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@cloudflare/workers-types": "4.20260515.1",
    "@openai/sites-vite-plugin": "0.2.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "oxfmt": "0.61.0",
    "oxlint": "1.76.0",
    "oxlint-tsgolint": "7.0.2001",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
